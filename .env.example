# ==============================================================================
# ResearchGPT - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' before starting Docker Compose or the local server:
#   cp .env.example .env
#
# DO NOT commit your real '.env' file or production credentials to version control.
# ==============================================================================

# Groq Cloud API Key (Optional)
# Used for synthesizing cited academic answers via Llama-3.3-70b-versatile.
# If omitted or left empty, ResearchGPT operates in high-performance Retrieval-Only mode.
GROQ_API_KEY=

# LLM Model Identifier on Groq Cloud
# Default: llama-3.3-70b-versatile
LLM_MODEL=llama-3.3-70b-versatile

# Host Port for the Nginx Web Application
# Default: 80 (change to 3000 or 8080 if port 80 is occupied on your host machine)
FRONTEND_PORT=80
